OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Security ---
# Required to call POST /api/upload. Set to any random string, then paste the
# same value into the "Admin key" field in the Document Upload tab.
# If unset, the upload endpoint is open (development mode).
ADMIN_API_KEY=

# Per-IP rate limits (slowapi syntax: "<count>/<period>")
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute

# Upload hard cap in megabytes
MAX_UPLOAD_MB=5
